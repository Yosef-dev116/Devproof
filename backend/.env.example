OPENAI_API_KEY=your-openai-api-key-here

# Optional but recommended: raises GitHub's API rate limit from 60/hour to 5000/hour.
# Generate at https://github.com/settings/tokens - no special scopes needed for public repo reads.
GITHUB_TOKEN=your-github-personal-access-token-here

# Required for "Sign in with GitHub". Create an OAuth App at
# https://github.com/settings/developers with callback URL
# {BACKEND_URL}/auth/github/callback (see BACKEND_URL below)
GITHUB_OAUTH_CLIENT_ID=your-github-oauth-client-id-here
GITHUB_OAUTH_CLIENT_SECRET=your-github-oauth-client-secret-here

# Required. A Postgres connection string. SQLite is no longer used - every
# environment (local dev and production) needs a real Postgres database.
# Locally, either run a local Postgres or point this at a free hosted instance
# (e.g. the same Render Postgres database used in production).
DATABASE_URL=postgresql://user:password@host:5432/devproof

# Set to "production" when deployed (e.g. on Render) - switches session/OAuth
# cookies to SameSite=None; Secure, which cross-domain deployments require.
# Leave unset for local dev.
ENVIRONMENT=production

# This backend's own public URL - used to build the GitHub OAuth callback URL.
# Local dev default: http://localhost:8002
BACKEND_URL=https://your-backend.onrender.com

# The frontend's public URL - the OAuth callback redirects here after login,
# and it must also be present in FRONTEND_ORIGINS below (for CORS).
# Local dev default: http://localhost:5180
FRONTEND_URL=https://your-frontend.vercel.app

# Comma-separated list of origins allowed to call this API (CORS).
# Local dev default: http://localhost:5180,http://127.0.0.1:5180
FRONTEND_ORIGINS=https://your-frontend.vercel.app
